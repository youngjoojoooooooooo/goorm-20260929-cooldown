[
  { "id": "v001", "kind": "scripture", "ref": "마태복음 11:28", "text": "수고하고 무거운 짐 진 자들아 다 내게로 오라 내가 너희를 쉬게 하리라", "moods": ["tired"], "pack": "free" },
  { "id": "v002", "kind": "scripture", "ref": "시편 23:1-2", "text": "여호와는 나의 목자시니 내가 부족함이 없으리로다 그가 나를 푸른 초장에 누이시며 쉴만한 물가으로 인도하시는도다", "moods": ["tired", "worried"], "pack": "free" },
  { "id": "v003", "kind": "scripture", "ref": "이사야 41:10", "text": "두려워 말라 내가 너와 함께 함이니라 놀라지 말라 나는 네 하나님이 됨이니라 내가 너를 굳세게 하리라 참으로 너를 도와주리라", "moods": ["anxious", "lonely"], "pack": "free" },
  { "id": "v004", "kind": "scripture", "ref": "빌립보서 4:6-7", "text": "아무 것도 염려하지 말고 다만 모든 일에 기도와 간구로 너희 구할 것을 감사함으로 하나님께 아뢰라 그리하면 모든 지각에 뛰어난 하나님의 평강이 그리스도 예수 안에서 너희 마음과 생각을 지키시리라", "moods": ["worried", "anxious"], "pack": "free" },
  { "id": "v005", "kind": "scripture", "ref": "베드로전서 5:7", "text": "너희 염려를 다 주께 맡겨 버리라 이는 저가 너희를 권고하심이니라", "moods": ["worried"], "pack": "free" },
  { "id": "v006", "kind": "scripture", "ref": "시편 46:1", "text": "하나님은 우리의 피난처시요 힘이시니 환난 중에 만날 큰 도움이시라", "moods": ["anxious"], "pack": "free" },
  { "id": "v007", "kind": "scripture", "ref": "요한복음 14:27", "text": "평안을 너희에게 끼치노니 곧 나의 평안을 너희에게 주노라 너희는 마음에 근심하지도 말고 두려워하지도 말라", "moods": ["anxious", "worried"], "pack": "free" },
  { "id": "v008", "kind": "scripture", "ref": "시편 4:8", "text": "내가 평안히 눕고 자기도 하리니 나를 안전히 거하게 하시는 이는 오직 여호와시니이다", "moods": ["anxious", "tired"], "pack": "free" },
  { "id": "v009", "kind": "scripture", "ref": "이사야 40:31", "text": "오직 여호와를 앙망하는 자는 새 힘을 얻으리니 독수리가 날개치며 올라감 같을 것이요 달음박질하여도 곤비치 아니하겠고 걸어가도 피곤치 아니하리로다", "moods": ["tired"], "pack": "free" },
  { "id": "v010", "kind": "scripture", "ref": "시편 34:18", "text": "여호와는 마음이 상한 자에게 가까이 하시고 중심에 통회하는 자를 구원하시는도다", "moods": ["hurt"], "pack": "free" },
  { "id": "v011", "kind": "scripture", "ref": "시편 147:3", "text": "상심한 자를 고치시며 저희 상처를 싸매시는도다", "moods": ["hurt"], "pack": "free" },
  { "id": "v012", "kind": "scripture", "ref": "신명기 31:6", "text": "네 하나님 여호와 그가 너와 함께 행하실 것임이라 결코 너를 떠나지 아니하시며 버리지 아니하시리라", "moods": ["lonely", "anxious"], "pack": "free" },
  { "id": "v013", "kind": "scripture", "ref": "데살로니가전서 5:16-18", "text": "항상 기뻐하라 쉬지 말고 기도하라 범사에 감사하라 이는 그리스도 예수 안에서 너희를 향하신 하나님의 뜻이니라", "moods": ["thankful"], "pack": "free" },
  { "id": "v014", "kind": "scripture", "ref": "시편 136:1", "text": "여호와께 감사하라 그는 선하시며 그 인자하심이 영원함이로다", "moods": ["thankful"], "pack": "free" },
  { "id": "v015", "kind": "scripture", "ref": "예레미야애가 3:22-23", "text": "여호와의 자비와 긍휼이 무궁하시므로 우리가 진멸되지 아니함이니이다 이것들이 아침마다 새로우니 주의 성실이 크도소이다", "moods": ["tired", "thankful"], "pack": "free" },
  { "id": "v016", "kind": "scripture", "ref": "시편 121:1-2", "text": "내가 산을 향하여 눈을 들리라 나의 도움이 어디서 올꼬 나의 도움이 천지를 지으신 여호와에게서로다", "moods": ["worried", "lonely"], "pack": "free" },
  { "id": "v017", "kind": "scripture", "ref": "로마서 8:28", "text": "우리가 알거니와 하나님을 사랑하는 자 곧 그 뜻대로 부르심을 입은 자들에게는 모든 것이 합력하여 선을 이루느니라", "moods": ["worried", "hurt"], "pack": "free" },
  { "id": "v018", "kind": "scripture", "ref": "시편 55:22", "text": "네 짐을 여호와께 맡겨 버리라 너를 붙드시고 의인의 요동함을 영영히 허락지 아니하시리로다", "moods": ["tired", "worried"], "pack": "free" },
  { "id": "v019", "kind": "scripture", "ref": "마태복음 28:20", "text": "볼지어다 내가 세상 끝날까지 너희와 항상 함께 있으리라", "moods": ["lonely"], "pack": "free" },
  { "id": "v020", "kind": "scripture", "ref": "고린도후서 12:9", "text": "내 은혜가 네게 족하도다 이는 내 능력이 약한 데서 온전하여짐이라", "moods": ["tired", "hurt"], "pack": "free" },

  { "id": "v021", "kind": "scripture", "ref": "시편 62:1", "text": "나의 영혼이 잠잠히 하나님만 바람이여 나의 구원이 저에게서 나는도다", "moods": ["anxious"], "pack": "pack_quiet_night" },
  { "id": "v022", "kind": "scripture", "ref": "시편 91:1", "text": "지존자의 은밀한 곳에 거하는 자는 전능하신 자의 그늘 아래 거하리로다", "moods": ["anxious"], "pack": "pack_quiet_night" },
  { "id": "v023", "kind": "scripture", "ref": "이사야 43:1", "text": "두려워 말라 내가 너를 구속하였고 내가 너를 지명하여 불렀나니 너는 내 것이라", "moods": ["lonely", "anxious"], "pack": "pack_quiet_night" },
  { "id": "v024", "kind": "scripture", "ref": "이사야 43:2", "text": "네가 물 가운데로 지날 때에 내가 함께 할 것이라 강을 건널 때에 물이 너를 침몰치 못할 것이며", "moods": ["anxious", "worried"], "pack": "pack_quiet_night" },
  { "id": "v025", "kind": "scripture", "ref": "스바냐 3:17", "text": "너의 하나님 여호와가 너의 가운데 계시니 그는 구원을 베푸실 전능자시라 너를 잠잠히 사랑하시며 너로 인하여 즐거이 부르며 기뻐하시리라", "moods": ["lonely", "hurt"], "pack": "pack_quiet_night" },
  { "id": "v026", "kind": "scripture", "ref": "시편 30:5", "text": "저녁에는 울음이 기숙할지라도 아침에는 기쁨이 오리로다", "moods": ["hurt"], "pack": "pack_quiet_night" },
  { "id": "v027", "kind": "scripture", "ref": "시편 56:8", "text": "나의 유리함을 주께서 계수하셨으니 나의 눈물을 주의 병에 담으소서", "moods": ["hurt"], "pack": "pack_quiet_night" },
  { "id": "v028", "kind": "scripture", "ref": "마태복음 6:34", "text": "그러므로 내일 일을 위하여 염려하지 말라 내일 일은 내일 염려할 것이요 한 날 괴로움은 그 날에 족하니라", "moods": ["worried"], "pack": "pack_quiet_night" },
  { "id": "v029", "kind": "scripture", "ref": "시편 127:2", "text": "여호와께서 그 사랑하시는 자에게는 잠을 주시는도다", "moods": ["tired"], "pack": "pack_quiet_night" },
  { "id": "v030", "kind": "scripture", "ref": "출애굽기 33:14", "text": "여호와께서 가라사대 내가 친히 가리라 내가 너로 편케 하리라", "moods": ["tired"], "pack": "pack_quiet_night" },
  { "id": "v031", "kind": "scripture", "ref": "시편 103:2", "text": "내 영혼아 여호와를 송축하며 그 모든 은택을 잊지 말지어다", "moods": ["thankful"], "pack": "pack_quiet_night" },
  { "id": "v032", "kind": "scripture", "ref": "시편 118:24", "text": "이 날은 여호와의 정하신 것이라 이 날에 우리가 즐거워하고 기뻐하리로다", "moods": ["thankful"], "pack": "pack_quiet_night" },
  { "id": "v033", "kind": "scripture", "ref": "골로새서 3:15", "text": "그리스도의 평강이 너희 마음을 주장하게 하라 너희는 또한 감사하는 자가 되라", "moods": ["thankful"], "pack": "pack_quiet_night" },
  { "id": "v034", "kind": "scripture", "ref": "시편 27:10", "text": "내 부모는 나를 버렸으나 여호와는 나를 영접하시리이다", "moods": ["lonely", "hurt"], "pack": "pack_quiet_night" },
  { "id": "v035", "kind": "scripture", "ref": "히브리서 13:5", "text": "내가 결코 너희를 버리지 아니하고 너희를 떠나지 아니하리라", "moods": ["lonely"], "pack": "pack_quiet_night" },
  { "id": "v036", "kind": "scripture", "ref": "시편 139:9-10", "text": "내가 새벽 날개를 치며 바다 끝에 가서 거할지라도 곧 거기서도 주의 손이 나를 인도하시며 주의 오른손이 나를 붙드시리이다", "moods": ["lonely"], "pack": "pack_quiet_night" },
  { "id": "v037", "kind": "scripture", "ref": "잠언 3:5-6", "text": "너는 마음을 다하여 여호와를 의뢰하고 네 명철을 의지하지 말라 너는 범사에 그를 인정하라 그리하면 네 길을 지도하시리라", "moods": ["worried"], "pack": "pack_quiet_night" },
  { "id": "v038", "kind": "scripture", "ref": "시편 42:5", "text": "내 영혼아 네가 어찌하여 낙망하며 어찌하여 내 속에서 불안하여 하는고 너는 하나님을 바라라", "moods": ["anxious", "tired"], "pack": "pack_quiet_night" },
  { "id": "v039", "kind": "scripture", "ref": "요한복음 16:33", "text": "세상에서는 너희가 환난을 당하나 담대하라 내가 세상을 이기었노라", "moods": ["worried", "anxious"], "pack": "pack_quiet_night" },
  { "id": "v040", "kind": "scripture", "ref": "시편 116:7", "text": "내 영혼아 네 평안함에 돌아갈지어다 여호와께서 너를 후대하심이로다", "moods": ["tired", "thankful"], "pack": "pack_quiet_night" },

  { "id": "c001", "kind": "comfort", "text": "오늘 하루도 정말 수고 많았어요. 이제는 내려놓고 쉬어도 괜찮아요.", "moods": ["tired"], "pack": "free" },
  { "id": "c002", "kind": "comfort", "text": "잘하지 못한 날에도 당신은 여전히 사랑받는 사람이에요.", "moods": ["hurt", "tired"], "pack": "free" },
  { "id": "c003", "kind": "comfort", "text": "지금 느끼는 불안은 지나가는 구름이에요. 하나님은 그 너머에 늘 계세요.", "moods": ["anxious"], "pack": "free" },
  { "id": "c004", "kind": "comfort", "text": "아무도 몰라준 오늘의 수고를 하나님은 다 보고 계셨어요.", "moods": ["hurt", "lonely"], "pack": "free" },
  { "id": "c005", "kind": "comfort", "text": "오늘 끝내지 못한 일은 내일의 몫이에요. 지금은 쉼의 시간이에요.", "moods": ["worried", "tired"], "pack": "free" },
  { "id": "c006", "kind": "comfort", "text": "혼자라고 느껴지는 밤에도, 당신은 결코 혼자가 아니에요.", "moods": ["lonely"], "pack": "free" },
  { "id": "c007", "kind": "comfort", "text": "숨을 천천히 들이쉬고, 내쉬어 보세요. 그거면 충분해요.", "moods": ["anxious", "tired"], "pack": "free" },
  { "id": "c008", "kind": "comfort", "text": "서운한 마음을 꾹 참느라 애썼어요. 그 마음, 여기 내려놓아도 돼요.", "moods": ["hurt"], "pack": "free" },
  { "id": "c009", "kind": "comfort", "text": "걱정은 주님께 맡기고, 당신은 편히 눈을 감아요.", "moods": ["worried"], "pack": "free" },
  { "id": "c010", "kind": "comfort", "text": "기도할 힘이 없는 날엔, 그저 머물러 있는 것도 기도예요.", "moods": ["tired", "lonely"], "pack": "free" },
  { "id": "c011", "kind": "comfort", "text": "무너진 것 같은 하루도, 다시 세워 주실 분이 계세요.", "moods": ["hurt", "worried"], "pack": "pack_quiet_night" },
  { "id": "c012", "kind": "comfort", "text": "당신의 눈물은 헛되지 않아요. 하나님은 하나도 잊지 않으세요.", "moods": ["hurt"], "pack": "pack_quiet_night" },
  { "id": "c013", "kind": "comfort", "text": "남과 비교하지 않아도 괜찮아요. 당신의 속도로 걸어가면 돼요.", "moods": ["anxious", "tired"], "pack": "pack_quiet_night" },
  { "id": "c014", "kind": "comfort", "text": "내일 일은 내일에게 맡기고, 오늘 밤은 오늘의 평안만 누려요.", "moods": ["worried"], "pack": "pack_quiet_night" },
  { "id": "c015", "kind": "comfort", "text": "연락할 사람이 떠오르지 않는 밤, 주님이 먼저 당신을 부르고 계세요.", "moods": ["lonely"], "pack": "pack_quiet_night" },
  { "id": "c016", "kind": "comfort", "text": "완벽하지 않아도 괜찮아요. 은혜는 부족한 곳에 더 넘쳐요.", "moods": ["anxious", "hurt"], "pack": "pack_quiet_night" },
  { "id": "c017", "kind": "comfort", "text": "오늘 받은 상처가 내일의 당신을 정하지 않아요.", "moods": ["hurt"], "pack": "pack_quiet_night" },
  { "id": "c018", "kind": "comfort", "text": "몸이 무거운 만큼 마음은 가벼워지도록, 지금 여기서 쉬어요.", "moods": ["tired"], "pack": "pack_quiet_night" },
  { "id": "c019", "kind": "comfort", "text": "답이 보이지 않아도, 길을 아시는 분이 함께 걸으세요.", "moods": ["worried", "anxious"], "pack": "pack_quiet_night" },
  { "id": "c020", "kind": "comfort", "text": "아무 말 하지 않아도 괜찮아요. 하나님은 당신의 한숨도 들으세요.", "moods": ["tired", "lonely"], "pack": "pack_quiet_night" },
  { "id": "c021", "kind": "comfort", "text": "오늘 참았던 말들, 이제 주님께 조용히 털어놓아도 돼요.", "moods": ["hurt", "lonely"], "pack": "pack_quiet_night" },
  { "id": "c022", "kind": "comfort", "text": "걱정이 밀려올 때마다 '주님께 맡깁니다' 하고 한 번 말해 보세요.", "moods": ["worried", "anxious"], "pack": "pack_quiet_night" },
  { "id": "c023", "kind": "comfort", "text": "당신이 버텨 낸 오늘은 결코 작은 일이 아니에요.", "moods": ["tired"], "pack": "pack_quiet_night" },
  { "id": "c024", "kind": "comfort", "text": "고요한 이 밤, 당신을 감싸는 평안이 있기를.", "moods": ["anxious", "lonely"], "pack": "pack_quiet_night" },
  { "id": "c025", "kind": "comfort", "text": "내일 아침은 오늘보다 조금 더 가벼울 거예요.", "moods": ["tired", "worried"], "pack": "pack_quiet_night" },

  { "id": "g001", "kind": "gratitude", "text": "오늘 하루를 무사히 마칠 수 있어서 감사합니다.", "moods": ["thankful", "tired"], "pack": "free" },
  { "id": "g002", "kind": "gratitude", "text": "지친 몸을 누일 곳이 있어 감사합니다.", "moods": ["thankful", "tired"], "pack": "free" },
  { "id": "g003", "kind": "gratitude", "text": "힘든 순간에도 숨 쉴 틈을 주셔서 감사합니다.", "moods": ["thankful", "anxious"], "pack": "free" },
  { "id": "g004", "kind": "gratitude", "text": "오늘 나에게 건네진 작은 친절에 감사합니다.", "moods": ["thankful", "lonely"], "pack": "free" },
  { "id": "g005", "kind": "gratitude", "text": "따뜻한 밥 한 끼를 먹을 수 있었음에 감사합니다.", "moods": ["thankful"], "pack": "free" },
  { "id": "g006", "kind": "gratitude", "text": "서운했던 마음까지도 주님께 말할 수 있어 감사합니다.", "moods": ["thankful", "hurt"], "pack": "free" },
  { "id": "g007", "kind": "gratitude", "text": "아직 모르는 내일을 주님께 맡길 수 있어 감사합니다.", "moods": ["thankful", "worried"], "pack": "free" },
  { "id": "g008", "kind": "gratitude", "text": "나를 위해 기도해 주는 사람이 있음에 감사합니다.", "moods": ["thankful", "lonely"], "pack": "free" },
